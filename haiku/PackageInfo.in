name			temino
version			@VERSION@-@REVISION@
architecture		@ARCH@
summary			"An ADHD-friendly, GPU-accelerated modern terminal, designed for the AI age"
description		"Temino is a modern terminal in the style of Warp: every command \
and its output is a block you can select and copy, commands are typed in an \
editor with syntax colors, history, autosuggestions and Tab completion, and \
full-screen programs get the whole window. It draws with Vulkan, so on the UTM \
VM it renders on the Mac's GPU through Venus."
packager		"John Zheng"
vendor			"bluevisor"
copyrights		"2026 John Zheng"
licenses		"MIT"
urls			"https://github.com/bluevisor/temino"

provides {
	temino = @VERSION@-@REVISION@
	app:Temino = @VERSION@
	cmd:temino = @VERSION@
}

requires {
	haiku
	bash
	lib:libgcc_s
	lib:libstdc++
}
